{
  // Desativa CodeLens invasivo
  "mermaidChart.showGenerateDiagramCodeLens": false,

  // Ativa sugestão completa de variáveis, constantes, funções e palavras-chave
  "editor.suggest.showVariables": true,
  "editor.suggest.showConstants": true,
  "editor.suggest.showFunctions": true,
  "editor.suggest.showClasses": true,
  "editor.suggest.showWords": true,
  "editor.suggest.showKeywords": true,
  "editor.suggest.showProperties": true,

  // Pré-seleciona a melhor sugestão para aceitar com Tab ou Enter rapidamente
  "editor.suggest.selectionMode": "always",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "on",

  // Sugestões instantâneas ao digitar
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.quickSuggestionsDelay": 0,
  "editor.suggestOnTriggerCharacters": true,

  // Sugestões baseadas nas variáveis e palavras dos arquivos abertos
  "editor.wordBasedSuggestions": "matchingDocuments",

  // Dicas automáticas de parâmetros ao chamar funções / parênteses
  "editor.parameterHints.enabled": true,
  "editor.parameterHints.cycle": true,

  // IntelliSense avançado para JavaScript
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.names": true,
  "javascript.suggest.paths": true,
  "javascript.suggest.autoImports": true,
  "javascript.suggest.includeAutomaticOptionalChainCompletions": true
}
